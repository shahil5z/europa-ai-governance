# Copy to backend/.env for local development. Never commit real values.
# Required: the only secret. Stays server-side (FastAPI), never sent to the browser.
OPENAI_API_KEY=

# Optional tuning (defaults shown).
OPENAI_MODEL=gpt-4.1-mini
OPENAI_CRITIC_MODEL=
OPENAI_TEMPERATURE=0.2
CALL_TIMEOUT_SECONDS=45
RUN_DEADLINE_SECONDS=240
MAX_REASSESSMENT_ROUNDS=1
RATE_LIMIT_REQUESTS=5
RATE_LIMIT_WINDOW_SECONDS=900
GLOBAL_RATE_LIMIT_REQUESTS=60
MAX_CONCURRENT_RUNS=4
CORS_ALLOW_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Local dev only (frontend): where next dev / next start proxies /api. Not used on Vercel.
BACKEND_URL=http://127.0.0.1:8000
